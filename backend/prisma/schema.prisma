generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Place {
  id          Int      @id @default(autoincrement())
  title       String
  name        String
  imageUrl    String?
  location    String?
  userId      Int
  rate        Float?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  whichLanguage String?
  davlat      String
  kimBilanBorishKerak String?
}